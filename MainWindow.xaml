<Window x:Class="FortniteTweakTool.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FortniteTweakTool"
 Title="Rage Tweaks" Icon="icon.ico" Height="820" Width="1260" MinHeight="700" MinWidth="1050"
 WindowStartupLocation="CenterScreen"
 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <local:AppliedVisibilityConverter x:Key="AppliedVis"/>
  <local:BoolTextConverter x:Key="BoolText"/>

  <!-- Rechtsklick-Menü im Design der App -->
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="Padding" Value="4"/>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Padding" Value="8,6"/>
  </Style>

  <!-- Karte fürs Dashboard und die Tweak-Liste -->
  <Style x:Key="DashCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Margin" Value="5"/>
  </Style>

  <!-- kleine Status-Pille (Fortnite, Ping) -->
  <Style x:Key="DashChip" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="15"/>
   <Setter Property="Padding" Value="13,7"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style x:Key="DashLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- alle Buttons: sanftes Wachsen beim Drüberfahren -->
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="RenderTransform">
    <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
   </Setter>
   <Style.Triggers>
    <EventTrigger RoutedEvent="UIElement.MouseEnter">
     <BeginStoryboard>
      <Storyboard>
       <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.12"/>
       <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.12"/>
      </Storyboard>
     </BeginStoryboard>
    </EventTrigger>
    <EventTrigger RoutedEvent="UIElement.MouseLeave">
     <BeginStoryboard>
      <Storyboard>
       <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
       <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
      </Storyboard>
     </BeginStoryboard>
    </EventTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="RootGrid">
  <!-- Hintergrund-Ebenen (Verlauf, Aurora, Bild/Video, Partikel) werden von BackgroundEngine befüllt -->
  <Grid x:Name="BackgroundHost" IsHitTestVisible="False"/>

  <Grid Margin="22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Header -->
   <Grid x:Name="HeaderGrid" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
    <Border CornerRadius="{DynamicResource PanelRadius}" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}"
            Effect="{DynamicResource GlowEffect}" Opacity="{DynamicResource GlowOpacity}" IsHitTestVisible="False"/>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource PanelRadius}" Padding="18">
     <DockPanel>
      <Image DockPanel.Dock="Left" Source="logo.png" Width="46" Height="46" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
       <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
       <Image.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
         <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
           <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.08" Duration="0:0:2.2">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
           <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.08" Duration="0:0:2.2">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </EventTrigger>
       </Image.Triggers>
      </Image>
      <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
       <TextBlock Text="RAGE TWEAKS" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}"/>
       <TextBlock Text="Performance • Input • Network" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
       <TextBlock x:Name="HeaderStatus" Text="Systemstatus wird geladen…" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Right"/>
       <TextBlock Text="Keine garantierten FPS-/Ping-Steigerungen" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </Grid>

   <!-- Navigation -->
   <Grid x:Name="NavGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
    <Border CornerRadius="{DynamicResource PanelRadius}" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}"
            Effect="{DynamicResource GlowEffect}" Opacity="{DynamicResource GlowOpacity}" IsHitTestVisible="False"/>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource PanelRadius}" Padding="10">
     <Grid x:Name="NavHost">
      <Border x:Name="NavIndicator" Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,0,0,0"
              IsHitTestVisible="False" Background="{DynamicResource AccentBrush}" Effect="{DynamicResource GlowEffect}">
       <Border.RenderTransform><TranslateTransform x:Name="NavMove"/></Border.RenderTransform>
      </Border>
      <StackPanel x:Name="NavPanel">
      <TextBlock Text="NAVIGATION" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,10,0,12"/>
      <Button x:Name="NavDashboard" Content="▦  Dashboard" Click="Dashboard_Click" HorizontalContentAlignment="Left"/>
      <Button Content="⚡  FPS Boost" Click="Fps_Click" HorizontalContentAlignment="Left"/>
      <Button Content="⌁  Input Delay" Click="Input_Click" HorizontalContentAlignment="Left"/>
      <Button Content="◉  Ping Optimizer" Click="Ping_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🔒  Privacy &amp; Ruhe" Click="Sys_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🧹  Cleaner" Click="Clean_Click" HorizontalContentAlignment="Left"/>
      <Button Content="↶  Restore Center" Click="Restore_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🖥  Overlay" Click="Overlay_Click" HorizontalContentAlignment="Left"/>
      <Button Content="🎨  Design &amp; Effekte" Click="Design_Click" HorizontalContentAlignment="Left"/>
      <Button Content="⚙  Settings &amp; Logs" Click="Settings_Click" HorizontalContentAlignment="Left"/>
      <Border Background="{DynamicResource Panel2Brush}" CornerRadius="{DynamicResource CardRadius}" Padding="10" Margin="4,24,4,0">
       <TextBlock Text="Sicherheit zuerst&#10;Benutzer-Tweaks sind einzeln umkehrbar. Wiederherstellungspunkt, Energieplan und DNS-Reset fragen per UAC. Vor Änderungen wird versucht, einen Wiederherstellungspunkt anzulegen." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
      </Border>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>

   <!-- Inhalt -->
   <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="1">
    <Border CornerRadius="{DynamicResource PanelRadius}" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}"
            Effect="{DynamicResource GlowEffect}" Opacity="{DynamicResource GlowOpacity}" IsHitTestVisible="False"/>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource PanelRadius}" Padding="22">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,18">
       <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="26" FontWeight="Bold"/>
       <TextBlock x:Name="PageSubtitle" Text="Echte Systemdaten und nachvollziehbare Aktionen." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1" x:Name="PageHost">
       <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>

       <!-- Dashboard -->
       <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,12">

         <!-- Kopfkarte: System, Fortnite, Ping -->
         <Border x:Name="DashHero" Style="{StaticResource DashCard}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="SYSTEM" Style="{StaticResource DashLabel}"/>
            <TextBlock x:Name="DashWindows" Text="Windows wird geprüft" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DashHardware" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
           </StackPanel>
           <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0">
            <Border Style="{StaticResource DashChip}">
             <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="FnDot" Width="9" Height="9" Fill="#7A7A7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Fortnite" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="DashFortnite" Text="Status unbekannt" FontWeight="SemiBold"/>
             </StackPanel>
            </Border>
            <Border Style="{StaticResource DashChip}" Margin="0">
             <StackPanel Orientation="Horizontal">
              <TextBlock Text="Ping" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="DashPing" Text="–" FontWeight="SemiBold"/>
             </StackPanel>
            </Border>
           </StackPanel>
           <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button Content="Ping testen" Click="PingTest_Click"/>
            <Button Content="System neu scannen" Click="Refresh_Click"/>
           </WrapPanel>
          </Grid>
         </Border>

         <!-- Ringe: CPU, GPU, RAM, VRAM (werden im Code befüllt) -->
         <UniformGrid x:Name="RingHost" Rows="1" Columns="4"/>

         <!-- Verlaufsgrafiken wie im MSI Afterburner (werden im Code befüllt) -->
         <UniformGrid x:Name="GraphHost" Columns="2"/>

         <!-- CPU-Kerne -->
         <Border x:Name="CoreHost" Style="{StaticResource DashCard}"/>

         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="AnalysisCard" Style="{StaticResource DashCard}">
           <StackPanel>
            <TextBlock Text="SYSTEMANALYSE" Style="{StaticResource DashLabel}" Margin="0,0,0,10"/>
            <TextBox x:Name="SystemReport" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="260" FontFamily="Consolas" FontSize="12"/>
           </StackPanel>
          </Border>
          <Border x:Name="OneClickCard" Grid.Column="1" Style="{StaticResource DashCard}">
           <StackPanel>
            <TextBlock Text="ONE-CLICK OPTIMIZATION" Style="{StaticResource DashLabel}" TextWrapping="Wrap"/>
            <TextBlock Text="Aktiviert Windows Game Mode und optional den Hochleistungs-Energieplan. Vorher wird ein Wiederherstellungspunkt versucht. Jede Änderung kann UAC erfordern." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,14"/>
            <CheckBox x:Name="OneClickGameMode" Content="Game Mode aktivieren" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,4" Checked="OneClickOption_Changed" Unchecked="OneClickOption_Changed"/>
            <CheckBox x:Name="OneClickPower" IsChecked="False" Foreground="{DynamicResource TextBrush}" Margin="0,4" Checked="OneClickOption_Changed" Unchecked="OneClickOption_Changed"><TextBlock Text="Hochleistungs-Energieplan aktivieren (mehr Strom/Hitze möglich)" TextWrapping="Wrap"/></CheckBox>
            <Button x:Name="OneClickButton" Content="OPTIMIERUNG STARTEN" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Click="OneClick_Click" Margin="0,16,0,0"/>
            <TextBlock x:Name="OneClickDone" Text="✓  Bereits aktiv" Visibility="Collapsed" Foreground="#3DDC84" FontWeight="Bold" FontSize="15" Margin="4,16,0,0"/>
            <TextBlock x:Name="ActionStatus" Text="Bereit." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,10,4,0"/>
           </StackPanel>
          </Border>
         </Grid>

        </StackPanel>
       </ScrollViewer>

       <!-- Tweaks / Restore / Settings / Design -->
       <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock x:Name="SectionIntro" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,0,4,16"/>

         <!-- Auswahl-Leiste: alles anwenden oder einzelne Tweaks auswählen (Checkbox oder Rechtsklick) -->
         <Border x:Name="TweakToolbar" Style="{StaticResource DashCard}" Margin="4,0,4,12" Padding="14,8" Visibility="Collapsed">
          <DockPanel>
           <TextBlock x:Name="SelectionInfo" DockPanel.Dock="Left" Text="Nichts ausgewählt" VerticalAlignment="Center" Margin="2,0,16,0" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
           <WrapPanel HorizontalAlignment="Right">
            <Button Content="Alle auswählen" Click="SelectAll_Click"/>
            <Button Content="Auswahl aufheben" Click="ClearSelection_Click"/>
            <Button x:Name="ApplySelectedButton" Content="Ausgewählte anwenden" Click="ApplySelected_Click" IsEnabled="False"/>
            <Button x:Name="ApplyAllButton" Content="Alle anwenden" Click="ApplyAll_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/>
           </WrapPanel>
          </DockPanel>
         </Border>
         <ItemsControl x:Name="TweaksList">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Border ClipToBounds="True" RenderTransformOrigin="0.5,0.5" MouseRightButtonDown="Tweak_RightClick">
             <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource DashCard}">
               <Setter Property="Margin" Value="4,4,4,10"/>
               <Setter Property="Padding" Value="0"/>
               <Style.Triggers>
                <!-- ausgewählte Karten bekommen einen Akzent-Rahmen -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                 <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                 <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </Border.Style>
             <Border.ContextMenu>
              <ContextMenu>
               <MenuItem Header="☑  Auswählen / Abwählen" Tag="{Binding Key}" Click="TweakMenu_Toggle"/>
               <MenuItem Header="▶  Nur diesen anwenden" Tag="{Binding Key}" Click="TweakMenu_Apply"/>
               <MenuItem Header="↶  Rückgängig machen" Tag="{Binding Key}" Click="TweakMenu_Undo" Visibility="{Binding UndoVisibility}"/>
               <Separator/>
               <MenuItem Header="Alle in dieser Kategorie auswählen" Click="TweakMenu_SelectAll"/>
              </ContextMenu>
             </Border.ContextMenu>
             <Border.RenderTransform>
              <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform X="0" Y="0"/></TransformGroup>
             </Border.RenderTransform>
             <Border.Triggers>
              <!-- Einblenden, wenn die Karte erscheint -->
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
               <BeginStoryboard>
                <Storyboard>
                 <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.45">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                 </DoubleAnimation>
                </Storyboard>
               </BeginStoryboard>
              </EventTrigger>
              <!-- Hover: leicht anheben -->
              <EventTrigger RoutedEvent="UIElement.MouseEnter">
               <BeginStoryboard>
                <Storyboard>
                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.008" Duration="0:0:0.15"/>
                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.008" Duration="0:0:0.15"/>
                </Storyboard>
               </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="UIElement.MouseLeave">
               <BeginStoryboard>
                <Storyboard>
                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                </Storyboard>
               </BeginStoryboard>
              </EventTrigger>
             </Border.Triggers>

             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

              <!-- Farbstreifen links: grün = aktiv, rot = Fehler, gelb pulsierend = läuft gerade -->
              <Border Grid.Column="0">
               <Border.Style>
                <Style TargetType="Border">
                 <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
                 <Setter Property="Opacity" Value="0.35"/>
                 <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Background" Value="#3DDC84"/><Setter Property="Opacity" Value="1"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusKind}" Value="fail"><Setter Property="Background" Value="#FF5C5C"/><Setter Property="Opacity" Value="1"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                   <Setter Property="Background" Value="#FFC66D"/>
                   <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="BusyPulse">
                     <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.6"/>
                     </Storyboard>
                    </BeginStoryboard>
                   </DataTrigger.EnterActions>
                   <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BusyPulse"/>
                   </DataTrigger.ExitActions>
                  </DataTrigger>
                 </Style.Triggers>
                </Style>
               </Border.Style>
              </Border>

              <!-- Auswahl-Checkbox (bei bereits aktiven Tweaks ausgeblendet) -->
              <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip="Für 'Ausgewählte anwenden' markieren (Rechtsklick wählt ebenfalls aus)">
               <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></CheckBox.LayoutTransform>
               <CheckBox.Visibility>
                <MultiBinding Converter="{StaticResource AppliedVis}">
                 <Binding Path="Status"/>
                 <Binding Path="CanUndo"/>
                </MultiBinding>
               </CheckBox.Visibility>
              </CheckBox>

              <StackPanel Grid.Column="2" Margin="14,14,12,14">
               <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/>
               <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
               <TextBlock Text="{Binding Risk, StringFormat='Risiko: {0}'}" Foreground="#FFC66D" Margin="0,7,0,0" FontSize="11"/>
               <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3" CornerRadius="10" BorderThickness="1">
                <Border.Style>
                 <Style TargetType="Border">
                  <Setter Property="Background" Value="#22FFFFFF"/>
                  <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Background" Value="#2A3DDC84"/><Setter Property="BorderBrush" Value="#3DDC84"/></DataTrigger>
                   <DataTrigger Binding="{Binding StatusKind}" Value="fail"><Setter Property="Background" Value="#2AFF5C5C"/><Setter Property="BorderBrush" Value="#FF5C5C"/></DataTrigger>
                   <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter Property="Background" Value="#2AFFC66D"/><Setter Property="BorderBrush" Value="#FFC66D"/></DataTrigger>
                  </Style.Triggers>
                 </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                 <TextBlock.Style>
                  <Style TargetType="TextBlock">
                   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                   <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Foreground" Value="#3DDC84"/></DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="fail"><Setter Property="Foreground" Value="#FF5C5C"/></DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter Property="Foreground" Value="#FFC66D"/></DataTrigger>
                   </Style.Triggers>
                  </Style>
                 </TextBlock.Style>
                </TextBlock>
               </Border>
              </StackPanel>

              <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="150">
               <!-- Aktiv-Anzeige: nur sichtbar, wenn der Tweak angewendet ist -->
               <Border Padding="12,7" CornerRadius="15" Background="#2A3DDC84" BorderBrush="#3DDC84" BorderThickness="1" Margin="4,0,4,6">
                <Border.Visibility>
                 <MultiBinding Converter="{StaticResource AppliedVis}" ConverterParameter="show">
                  <Binding Path="Status"/>
                  <Binding Path="CanUndo"/>
                 </MultiBinding>
                </Border.Visibility>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                 <Ellipse Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Ellipse.Triggers>
                   <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                     <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                     </Storyboard>
                    </BeginStoryboard>
                   </EventTrigger>
                  </Ellipse.Triggers>
                 </Ellipse>
                 <TextBlock Text="AKTIV" FontWeight="Bold" FontSize="12" Foreground="#3DDC84"/>
                </StackPanel>
               </Border>

               <!-- Anwenden: verschwindet, sobald der Tweak aktiv ist (Cleaner-Aktionen bleiben als "Ausführen") -->
               <Button Tag="{Binding Key}" Click="ApplyTweak_Click"
                       Content="{Binding CanUndo, Converter={StaticResource BoolText}, ConverterParameter='Anwenden|Ausführen'}">
                <Button.Visibility>
                 <MultiBinding Converter="{StaticResource AppliedVis}">
                  <Binding Path="Status"/>
                  <Binding Path="CanUndo"/>
                 </MultiBinding>
                </Button.Visibility>
               </Button>
               <Button Content="Rückgängig" Tag="{Binding Key}" Click="UndoTweak_Click" Visibility="{Binding UndoVisibility}"/>
              </StackPanel>
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>

         <StackPanel x:Name="RestoreActions" Visibility="Collapsed" Margin="4">
          <TextBlock Text="Wiederherstellung" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Windows-Wiederherstellungspunkte können je nach Systemrichtlinie deaktiviert sein. Die Registry-Backups werden lokal gespeichert." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <WrapPanel>
           <Button Content="Wiederherstellungspunkt erstellen" Click="RestorePoint_Click"/>
           <Button Content="Alle Tweaks rückgängig machen" Click="UndoAll_Click"/>
           <Button Content="Backup-Ordner öffnen" Click="OpenBackup_Click"/>
          </WrapPanel>
          <TextBlock x:Name="BackupInfo" TextWrapping="Wrap" Margin="4,12,4,0"/>
         </StackPanel>

         <StackPanel x:Name="SettingsActions" Visibility="Collapsed" Margin="4">
          <TextBlock Text="Einstellungen &amp; Protokolle" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Die App startet standardmäßig nicht automatisch mit Windows. Änderungen werden protokolliert." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <WrapPanel><Button Content="Log anzeigen" Click="ShowLog_Click"/><Button Content="Log-Ordner öffnen" Click="OpenLog_Click"/><Button Content="Log leeren" Click="ClearLog_Click"/></WrapPanel>
          <TextBox x:Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="10"/>
         </StackPanel>

         <StackPanel x:Name="OverlayActions" Visibility="Collapsed" Margin="4"/>

         <!-- ===================== DESIGN & EFFEKTE ===================== -->
         <StackPanel x:Name="DesignActions" Visibility="Collapsed" Margin="4">

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="DESIGN-VORLAGEN" Style="{StaticResource SectionTitle}"/>
            <WrapPanel x:Name="PresetPanel"/>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="HINTERGRUND" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
             <RadioButton x:Name="ModeSolid" Content="Einfarbig" GroupName="BgMode" Tag="Solid" Style="{StaticResource ChipStyle}" Checked="Mode_Checked"/>
             <RadioButton x:Name="ModeGradient" Content="Animierter Farbverlauf" GroupName="BgMode" Tag="AnimatedGradient" Style="{StaticResource ChipStyle}" Checked="Mode_Checked"/>
             <RadioButton x:Name="ModeAurora" Content="Aurora" GroupName="BgMode" Tag="Aurora" Style="{StaticResource ChipStyle}" Checked="Mode_Checked"/>
             <RadioButton x:Name="ModeCustom" Content="Eigenes Bild / Video" GroupName="BgMode" Tag="Custom" Style="{StaticResource ChipStyle}" Checked="Mode_Checked"/>
            </WrapPanel>
            <WrapPanel>
             <Button Content="📁  Bild / Video wählen…" Click="PickMedia_Click" Margin="0,0,4,4"/>
             <Button Content="Entfernen" Click="ClearMedia_Click" Margin="4,0,4,4"/>
            </WrapPanel>
            <TextBlock x:Name="MediaInfo" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Effektstärke (Verlauf / Aurora)" VerticalAlignment="Center"/>
             <Slider x:Name="SldIntensity" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldIntensity, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Animationsgeschwindigkeit" VerticalAlignment="Center"/>
             <Slider x:Name="SldSpeed" Grid.Column="1" Minimum="10" Maximum="300" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldSpeed, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Abdunkeln (Bild / Video)" VerticalAlignment="Center"/>
             <Slider x:Name="SldDim" Grid.Column="1" Minimum="0" Maximum="90" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldDim, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Unschärfe (nur Bilder)" VerticalAlignment="Center"/>
             <Slider x:Name="SldBlur" Grid.Column="1" Minimum="0" Maximum="30" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldBlur, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="FARBEN" Style="{StaticResource SectionTitle}"/>
            <ItemsControl x:Name="ColorList">
             <ItemsControl.ItemTemplate>
              <DataTemplate>
               <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="230"/><ColumnDefinition Width="50"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="34" Height="26" CornerRadius="6" Background="{Binding Brush}" HorizontalAlignment="Left"
                        BorderThickness="1" BorderBrush="{DynamicResource MutedBrush}" Cursor="Hand"
                        Tag="{Binding Key}" MouseLeftButtonUp="Swatch_Click"/>
                <TextBox Grid.Column="2" Text="{Binding Hex, Mode=OneWay}" Tag="{Binding Key}" FontFamily="Consolas" Padding="6,4"
                         Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource PanelBorderBrush}" CaretBrush="{DynamicResource TextBrush}"
                         LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"/>
                <Button Grid.Column="3" Content="Wählen…" Tag="{Binding Key}" Click="PickColor_Click" Padding="12,5" Margin="8,0,0,0"/>
               </Grid>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="PARTIKEL-EFFEKT" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="ChkParticles" Content="Partikel anzeigen" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Anzahl" VerticalAlignment="Center"/>
             <Slider x:Name="SldParticles" Grid.Column="1" Minimum="0" Maximum="250" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldParticles, StringFormat={}{0:0}}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
             <RadioButton x:Name="PartFloat" Content="Aufsteigend" GroupName="PStyle" Tag="Float" Style="{StaticResource ChipStyle}" Checked="ParticleStyle_Checked"/>
             <RadioButton x:Name="PartSnow" Content="Fallend (Schnee / Matrix)" GroupName="PStyle" Tag="Snow" Style="{StaticResource ChipStyle}" Checked="ParticleStyle_Checked"/>
             <RadioButton x:Name="PartDrift" Content="Schwebend" GroupName="PStyle" Tag="Drift" Style="{StaticResource ChipStyle}" Checked="ParticleStyle_Checked"/>
            </WrapPanel>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="OBERFLÄCHE &amp; EFFEKTE" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Panel-Deckkraft (Glas-Effekt)" VerticalAlignment="Center"/>
             <Slider x:Name="SldPanelOpacity" Grid.Column="1" Minimum="20" Maximum="100" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldPanelOpacity, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Eckenradius" VerticalAlignment="Center"/>
             <Slider x:Name="SldRadius" Grid.Column="1" Minimum="0" Maximum="32" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldRadius, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Neon-Glow um Panels" VerticalAlignment="Center"/>
             <Slider x:Name="SldGlow" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldGlow, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <CheckBox x:Name="ChkPageAnim" Content="Animation beim Seitenwechsel" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,10" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            <TextBlock Text="Schriftart" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <WrapPanel x:Name="FontPanel"/>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="FENSTER &amp; GRÖSSE" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Oberflächen-Größe (Zoom)" VerticalAlignment="Center"/>
             <Slider x:Name="SldScale" Grid.Column="1" Minimum="80" Maximum="140" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldScale, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Fenster-Transparenz" VerticalAlignment="Center"/>
             <Slider x:Name="SldWinOpacity" Grid.Column="1" Minimum="50" Maximum="100" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldWinOpacity, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <Grid Margin="0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
             <TextBlock Text="Rahmen um Panels" VerticalAlignment="Center"/>
             <Slider x:Name="SldBorder" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Slider_Changed"/>
             <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldBorder, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <CheckBox x:Name="ChkTopMost" Content="Fenster immer im Vordergrund" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
           </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
           <StackPanel>
            <TextBlock Text="DESIGN VERWALTEN" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
             <Button Content="Design exportieren…" Click="ExportTheme_Click"/>
             <Button Content="Design importieren…" Click="ImportTheme_Click"/>
             <Button Content="Auf Standard zurücksetzen" Click="ResetTheme_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ThemePathInfo" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,8,0,0"/>
           </StackPanel>
          </Border>
         </StackPanel>
        </StackPanel>
       </ScrollViewer>
      </Grid>
     </Grid>
    </Border>
   </Grid>

   <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
    <!-- Erscheint nur, wenn ein angewendeter Tweak einen Neustart oder eine Neuanmeldung braucht -->
    <Border x:Name="RestartBar" Visibility="Collapsed" Padding="14,10" Margin="0,0,0,8" CornerRadius="12" BorderThickness="1" Background="#2AFFC66D" BorderBrush="#FFC66D">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
       <Button x:Name="RestartNowButton" Content="Jetzt neu starten" Click="RestartNow_Click" Margin="4,0"/>
       <Button x:Name="LogoffButton" Content="Abmelden" Click="Logoff_Click" Margin="4,0"/>
       <Button Content="Später" Click="RestartLater_Click" Margin="4,0"/>
      </StackPanel>
      <TextBlock x:Name="RestartText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
     </DockPanel>
    </Border>
    <TextBlock Text="Rage Tweaks v3 • Transparente Tweaks statt fragwürdiger Registry-Sammlungen • lokale Logs • Falls ein Neustart nötig ist, erscheint hier unten ein Hinweis" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
